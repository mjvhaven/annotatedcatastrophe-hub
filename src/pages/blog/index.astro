---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Blog">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold mb-2">Blog</h1>
    <p class="text-gray-400 mb-8">Thoughts, updates, and tutorials.</p>
    <div class="space-y-6">
      <article class="bg-gray-800 rounded-xl p-6 border border-gray-700">
        <h2 class="text-2xl font-semibold mb-2">Welcome to annotatedcatastrophe</h2>
        <p class="text-gray-400 text-sm mb-4">2026-01-01 · 1 min read</p>
        <p class="text-gray-300">A new hub for creative projects, tools, and experiments. Stick around for hex maps, custom calendars, and weird things in between.</p>
      </article>
      <p class="text-gray-500 text-center py-8">More posts coming soon.</p>
    </div>
  </div>
</Layout>
